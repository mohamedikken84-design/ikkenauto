# Voorbeeld voor lokale ontwikkeling. Geen productiecredential. Kopieer naar .env en vul lokaal in.
DATABASE_URL=postgres://ikkenauto:local-dev-only@127.0.0.1:5432/ikkenauto_test
AUTH_MODE=development-session
MAIL_TRANSPORT=local
APP_ORIGIN=http://127.0.0.1:3000
# Optioneel in ontwikkeling of test, 1 tot 20. Productie negeert dit en gebruikt 5 per 15 minuten.
# AUTH_RATE_LIMIT_MAX=5
# Zet op 1 om de fictieve ontwikkelcatalogus apart te tonen. Nooit als echte voorraad.
DEV_SHOW_FICTIONAL_CATALOG=0
